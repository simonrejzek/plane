	reverse_proxy @users_me pi:8080

	# GET-only wrappers (POST/PATCH/DELETE for modules must stay on CE API)
	@proj_modules {
		method GET
		path_regexp ^/api/workspaces/[^/]+/projects/[^/]+/modules/?$
