(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

	redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

	redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000

	reverse_proxy /live/* live:3000

	# Plane Intelligence (Pilot AI) — before generic /api/*
	reverse_proxy /api/v1/* pi:8080
	reverse_proxy /cosmic-pilot/* pi:8080
	reverse_proxy /cosmic-pilot-inject.js pi:8080

	# Commercial SPA ↔ CE compatibility (hosted on PI).
	# Each reverse_proxy path is OR'd within its matcher; keep them separate
	# so Caddy does not AND unrelated path_regexps together.
	reverse_proxy /api/payments/* pi:8080
	reverse_proxy /api/users/me/workspaces/ pi:8080
	reverse_proxy /api/users/me/workspaces pi:8080

	# Workspace-scoped commercial endpoints (regex matchers)
	@ws_permissions path_regexp ^/api/workspaces/[^/]+/permissions/?$
	reverse_proxy @ws_permissions pi:8080

	@ws_features path_regexp ^/api/workspaces/[^/]+/features/?$
	reverse_proxy @ws_features pi:8080

	@ws_roles path_regexp ^/api/workspaces/[^/]+/roles/?$
	reverse_proxy @ws_roles pi:8080

	@ws_schemes path_regexp ^/api/workspaces/[^/]+/permission-schemes/?$
	reverse_proxy @ws_schemes pi:8080

	@ws_wpf path_regexp ^/api/workspaces/[^/]+/workspace-project-features/?$
	reverse_proxy @ws_wpf pi:8080

	# Commercial project list (CE uses /projects/; SPA uses /projects-lite/)
	@ws_projects_lite path_regexp ^/api/workspaces/[^/]+/projects-lite/?$
	reverse_proxy @ws_projects_lite pi:8080

	@ws_preferences path_regexp ^/api/workspaces/[^/]+/preferences/?$
	reverse_proxy @ws_preferences pi:8080

	@ws_workflows path_regexp ^/api/workspaces/[^/]+/workflows/?$
	reverse_proxy @ws_workflows pi:8080

	@ws_wit path_regexp ^/api/workspaces/[^/]+/work-item-types/?$
	reverse_proxy @ws_wit pi:8080

	@ws_templates path_regexp ^/api/workspaces/[^/]+/workitems/templates/?$
	reverse_proxy @ws_templates pi:8080

	@ws_reldefs path_regexp ^/api/workspaces/[^/]+/work-item-relation-definitions/?$
	reverse_proxy @ws_reldefs pi:8080

	@ws_modules_lite path_regexp ^/api/workspaces/[^/]+/(modules-lite|cycles-lite)/?$
	reverse_proxy @ws_modules_lite pi:8080

	@proj_modules_lite path_regexp ^/api/workspaces/[^/]+/projects/[^/]+/modules-lite/?$
	reverse_proxy @proj_modules_lite pi:8080

	@proj_features path_regexp ^/api/workspaces/[^/]+/projects/[^/]+/features/?$
	reverse_proxy @proj_features pi:8080

	@ws_teamspaces path_regexp ^/api/workspaces/[^/]+/teamspaces/?$
	reverse_proxy @ws_teamspaces pi:8080

	@ws_customers path_regexp ^/api/workspaces/[^/]+/customers/?$
	reverse_proxy @ws_customers pi:8080

	@ws_releases path_regexp ^/api/workspaces/[^/]+/releases(-lite)?/?$
	reverse_proxy @ws_releases pi:8080

	@ws_initiatives path_regexp ^/api/workspaces/[^/]+/initiatives/?$
	reverse_proxy @ws_initiatives pi:8080

	# Integrations / silo stubs
	@apps_integrations path_regexp ^/api/apps/[^/]+/enabled-integrations/?$
	reverse_proxy @apps_integrations pi:8080

	@connections path_regexp ^/api/connections/
	reverse_proxy @connections pi:8080

	@silo path_regexp ^/api/silo/
	reverse_proxy @silo pi:8080

	# Wiki pages live on PI (CE lacks workspace-level pages API)
	@ws_wiki_pages path_regexp ^/api/workspaces/[^/]+/pages
	reverse_proxy @ws_wiki_pages pi:8080

	# CE API (projects, issues, modules, labels, worklogs, auth, …)
	reverse_proxy /api/* api:8000
	reverse_proxy /auth/* api:8000

	# Official mobile app GraphQL
	reverse_proxy /graphql/* api:8000
	reverse_proxy /graphql api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	# SPA routes including /m/auth
	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}
